# Server-only PostgreSQL connection for IntentChord development.
# Copy this file to .env.local, replace CHANGE_ME locally, and never commit or package .env.local.
DATABASE_URL=postgresql://intentchord_app:CHANGE_ME@127.0.0.1:5432/intentchord_dev

# IntentChord Internal AI / Context Mapper — governed server-only runtime configuration.
# Provider/Model identity is runtime configuration, not customer-facing product identity.
# Compatible Provider/Model experimentation within a supported transport/behavior profile
# must not require source edits or further DB migrations after Migration 013.
AI_CONTEXT_MAPPER_ENABLED=false

# Internal AI Engine Registry / Qualification authority (server-side only).
# Provider/Model/endpoint are runtime data. Registration or Owner enablement does NOT create qualification.
# IntentChord deterministically derives engineConfigurationSha256 from the governed non-secret Engine configuration.
# Qualification records MUST carry that exact engineConfigurationSha256; stale qualification fails closed even if revision label is reused.
# Secret credential VALUES are never fingerprint inputs; only credentialReference is bound.
# This registry is current-state, not a ledger: more than one record for the same engineId+revision+scope is ambiguous and fails closed.
# For multiple compatible Engines, set AI_CONTEXT_MAPPER_ENGINE_REGISTRY_JSON to a JSON array of definitions.
AI_CONTEXT_MAPPER_ENGINE_REGISTRY_JSON=
AI_CONTEXT_MAPPER_QUALIFICATION_REGISTRY_JSON=
AI_CONTEXT_MAPPER_OWNER_ENABLED_ENGINE_IDS=
AI_CONTEXT_MAPPER_SELECTION_POLICY_ID=internal-ai-context-mapping-single
AI_CONTEXT_MAPPER_SELECTION_POLICY_VERSION=1
AI_CONTEXT_MAPPER_SELECTION_POLICY_MODE=SINGLE

# Legacy single-slot configuration remains a deployment convenience when ENGINE_REGISTRY_JSON is unset.
# It defines Engine data only; explicit qualification + Owner-enabled configuration are still required before production mapping.
AI_CONTEXT_MAPPER_PRIMARY_ENGINE_ID=internal-context-mapper-active-default
AI_CONTEXT_MAPPER_PRIMARY_ENGINE_REVISION=1
AI_CONTEXT_MAPPER_PRIMARY_PROVIDER=zai
AI_CONTEXT_MAPPER_PRIMARY_CHANNEL=zai_direct_chat_completions_v4
AI_CONTEXT_MAPPER_PRIMARY_MODEL=glm-4.7-flash
AI_CONTEXT_MAPPER_PRIMARY_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
AI_CONTEXT_MAPPER_PRIMARY_CREDENTIAL_ENV=ZAI_API_KEY
AI_CONTEXT_MAPPER_PRIMARY_TRANSPORT_PROFILE=chat_completions_json_object_v1
AI_CONTEXT_MAPPER_PRIMARY_BEHAVIOR_PROFILE=zai_error_semantics_v1
AI_CONTEXT_MAPPER_PRIMARY_CAPABILITY_PROFILE_VERSION=AI_CONTEXT_MAPPING_V1/default
AI_CONTEXT_MAPPER_PRIMARY_TIMEOUT_MS=60000

AI_CONTEXT_MAPPER_CANDIDATE_ENGINE_ID=
AI_CONTEXT_MAPPER_CANDIDATE_ENGINE_REVISION=
AI_CONTEXT_MAPPER_CANDIDATE_PROVIDER=
AI_CONTEXT_MAPPER_CANDIDATE_CHANNEL=
AI_CONTEXT_MAPPER_CANDIDATE_MODEL=
AI_CONTEXT_MAPPER_CANDIDATE_ENDPOINT=
AI_CONTEXT_MAPPER_CANDIDATE_CREDENTIAL_ENV=
AI_CONTEXT_MAPPER_CANDIDATE_TRANSPORT_PROFILE=
AI_CONTEXT_MAPPER_CANDIDATE_BEHAVIOR_PROFILE=
AI_CONTEXT_MAPPER_CANDIDATE_CAPABILITY_PROFILE_VERSION=
AI_CONTEXT_MAPPER_CANDIDATE_TIMEOUT_MS=

AI_CONTEXT_MAPPER_STANDBY_ENGINE_ID=internal-context-mapper-standby-default
AI_CONTEXT_MAPPER_STANDBY_ENGINE_REVISION=1
AI_CONTEXT_MAPPER_STANDBY_PROVIDER=sambanova
AI_CONTEXT_MAPPER_STANDBY_CHANNEL=sambanova_direct_chat_completions_v1
AI_CONTEXT_MAPPER_STANDBY_MODEL=gpt-oss-120b
AI_CONTEXT_MAPPER_STANDBY_ENDPOINT=https://api.sambanova.ai/v1/chat/completions
AI_CONTEXT_MAPPER_STANDBY_CREDENTIAL_ENV=SAMBANOVA_API_KEY
AI_CONTEXT_MAPPER_STANDBY_TRANSPORT_PROFILE=chat_completions_json_schema_v1
AI_CONTEXT_MAPPER_STANDBY_BEHAVIOR_PROFILE=sambanova_error_semantics_v1
AI_CONTEXT_MAPPER_STANDBY_CAPABILITY_PROFILE_VERSION=AI_CONTEXT_MAPPING_V1/default
AI_CONTEXT_MAPPER_STANDBY_TIMEOUT_MS=60000
AI_CONTEXT_MAPPER_STANDBY_ENABLED=false

AI_CONTEXT_MAPPER_LIVE_PROVIDER_TESTS_ENABLED=false

# Trusted server-side secret values. Never expose these to browser/customer DTOs or reports.
ZAI_API_KEY=
SAMBANOVA_API_KEY=
